# ─────────────────────────────
# S3 / MinIO
# ─────────────────────────────
S3_BUCKET=events-bucket

S3_ENDPOINT=http://host.docker.internal:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ─────────────────────────────
# RocksDB Shards (gRPC)
# One entry per shard, comma-separated, same order as the writer
# ─────────────────────────────
SHARD_URLS=host.docker.internal:9002,host.docker.internal:9012,host.docker.internal:9022,host.docker.internal:9032,host.docker.internal:9042

# ─────────────────────────────
# HTTP Server
# ─────────────────────────────
HTTP_PORT=8088