  "panels": [
    {
      "title": "🔥 Query Throughput (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(queries_total_total[1m])",
          "legendFormat": "queries/sec (server)"
        },
        {
          "expr": "rate(http_reqs_total[1m])",
          "legendFormat": "requests/sec (k6)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 15 }
        }
      }
    },
    {
      "title": "⏱ Query Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(query_duration_bucket[1m])) by (le))",
          "legendFormat": "p50 (server)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(query_duration_bucket[1m])) by (le))",
          "legendFormat": "p95 (server)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(query_duration_bucket[1m])) by (le))",
          "legendFormat": "p99 (server)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_req_duration_milliseconds_bucket[1m])) by (le)) / 1000",
          "legendFormat": "p95 (k6 client)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
